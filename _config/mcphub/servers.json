{
  "mcpServers": {
    "blender": {
      "args": [
        "blender-mcp"
      ],
      "command": "uvx",
      "name": "github.com/ahujasid/blender-mcp"
    },
    "context7": {
      "type": "streamable-http",
      "url": "https://mcp.context7.com/mcp"
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "command": "uvx"
    },
    "git": {
      "args": [
        "mcp-server-git",
        "--repository",
        "${REPOSITORY_PATH}"
      ],
      "command": "uvx"
    },
    "markitdown": {
      "args": [
        "run",
        "--rm",
        "-i",
        "markitdown-mcp:latest"
      ],
      "command": "podman",
      "disabled": false
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx"
    },
    "tavily": {
      "args": [
        "-y",
        "tavily-mcp@0.1.3"
      ],
      "command": "npx",
      "disabled": true,
      "name": "tavily"
    }
  },
  "nativeMCPServers": {
    "neovim": {
      "disabled": false
    }
  }
}
